{
  "name": "planificador-viajes-estudiantes-unl",
  "version": "0.2.0",
  "description": "Planificador de viajes intercantonales para estudiantes de la UNL (DAG, orden topologico y Floyd-Warshall)",
  "main": "src/main/view/servidor.js",
  "scripts": {
    "start": "npm --prefix mobile-app start",
    "dev": "npm --prefix mobile-app start",
    "mobile:install": "npm --prefix mobile-app install",
    "mobile:android": "npm --prefix mobile-app run android",
    "mobile:ios": "npm --prefix mobile-app run ios",
    "mobile:lint": "npm --prefix mobile-app run lint",
    "mobile:typecheck": "npm --prefix mobile-app run typecheck",
    "api": "PORT=3001 node src/main/view/servidor.js",
    "api:dev": "PORT=3001 node --watch src/main/view/servidor.js",
    "demo": "node src/main/js/index.js",
    "test": "node tests/smoke.test.js && node tests/listaDoble.test.js && node tests/sort.test.js && node tests/search.test.js && node tests/datosBusqueda.test.js",
    "benchmark:busqueda": "node scripts/busqueda/benchmark_busqueda.js",
    "datos:busqueda": "node scripts/busqueda/preparar_datos_busqueda.js",
    "benchmark": "node scripts/ordenamiento/benchmark_ordenamiento.js",
    "benchmark:sort": "node --expose-gc scripts/ordenamiento/benchmark_ordenamiento.js --ordenamiento",
    "demo:busqueda": "node scripts/busqueda/demo_busqueda.js",
    "comparar:busqueda": "node scripts/busqueda/benchmark_comparativo.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "license": "ISC"
}